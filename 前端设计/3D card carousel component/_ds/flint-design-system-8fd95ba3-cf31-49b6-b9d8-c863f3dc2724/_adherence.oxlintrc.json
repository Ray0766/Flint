{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/status/**",
              "components/surfaces/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Noto Sans SC|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Noto Sans SC, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChannelValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:channel|value|unit|dim|style|key|ref|className|style|children)$/]",
        "message": "<ChannelValue> doesn't accept that prop. Declared props: channel, value, unit, dim, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChannelValue'] > JSXAttribute[name.name='channel'] > Literal[value!=/^(?:fact|price|self)$/]",
        "message": "<ChannelValue> channel must be one of 'fact' | 'price' | 'self'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sourceNote|height|style|key|ref|className|style|children)$/]",
        "message": "<ChartPlaceholder> doesn't accept that prop. Declared props: title, sourceNote, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|source|style|key|ref|className|style|children)$/]",
        "message": "<CitationMark> doesn't accept that prop. Declared props: index, source, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|channel|unit|num|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, channel, unit, num."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='channel'] > Literal[value!=/^(?:fact|price|self)$/]",
        "message": "<DataTableColumn> channel must be one of 'fact' | 'price' | 'self'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DegradedNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<DegradedNotice> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|footer|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, children, footer, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|actionLabel|onAction|illustration|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, actionLabel, onAction, illustration, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='illustration'] > Literal[value!=/^(?:spark|lens|page)$/]",
        "message": "<EmptyState> illustration must be one of 'spark' | 'lens' | 'page'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|placeholder|mono|hint|error|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, placeholder, mono, hint, error, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|texture|padding|radius|border|children|style|key|ref|className|style|children)$/]",
        "message": "<PaperSurface> doesn't accept that prop. Declared props: tone, texture, padding, radius, border, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperSurface'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|paper|paper-2)$/]",
        "message": "<PaperSurface> tone must be one of 'surface' | 'paper' | 'paper-2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperSurface'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:card|data)$/]",
        "message": "<PaperSurface> radius must be one of 'card' | 'data'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SealedBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|style|key|ref|className|style|children)$/]",
        "message": "<SealedBlock> doesn't accept that prop. Declared props: label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusMark> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMark'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:verified|review|blocking|disputed|speculative|void|sealed|degraded)$/]",
        "message": "<StatusMark> status must be one of 'verified' | 'review' | 'blocking' | 'disputed' | 'speculative' | 'void' | 'sealed' | 'degraded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|rotate|tone|mono|style|key|ref|className|style|children)$/]",
        "message": "<StickerTag> doesn't accept that prop. Declared props: children, rotate, tone, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|indigo|sulfur|moss)$/]",
        "message": "<StickerTag> tone must be one of 'paper' | 'indigo' | 'sulfur' | 'moss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, active, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoidBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|height|note|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<VoidBlock> doesn't accept that prop. Declared props: kind, height, note, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoidBlock'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:missing-data|no-access)$/]",
        "message": "<VoidBlock> kind must be one of 'missing-data' | 'no-access'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
