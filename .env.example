# 宿主机侧连接（compose 端口映射 55432/56379）
FLINT_ENV=dev
DATABASE_URL=postgresql+asyncpg://flint:flint@localhost:55432/flint
REDIS_URL=redis://localhost:56379/0

# LLM 供应端（产品分层级；全部运行环境自配，NEVER 提交真实值/key 进仓）
# Which one the demo stack uses (harness/demo_model.py, NARROW-04):
#   unset or local -> the local endpoint below, no key
#   anthropic | deepseek | openai -> that vendor's block further down, read by its loader
# FLINT_DEMO_PROVIDER=
# 免费档 = 本地 OpenAI 兼容端点（owner 裁决；本地路径零 API 费）
FLINT_LOCAL_BASE_URL=http://localhost:11434/v1
FLINT_LOCAL_MODELS=model-a,model-b
FLINT_FREE_TIER_MODEL=model-a
# FLINT_LOCAL_API_KEY=            # 多数本地端点不需要；需要时在环境注入
# 付费档（启用时自配；价目各项是 cost 记账出处，NEVER 内置价表）
#
# 变量名一律 `FLINT_` 前缀 —— 代码读的就是带前缀的那个
# （production.py#load_anthropic_tier / load_deepseek_tier / load_openai_tier）。
# 此前模板写的是无前缀的 `ANTHROPIC_API_KEY`，照它配会配不上，
# 而失败形态是「key 读不到」而不是「模板写错」：人会去查代码，不会去查自己那行模板。
# FLINT_ANTHROPIC_API_KEY=              # NEVER 写入仓库/日志/会话
# FLINT_PAID_TIER_MODEL=
# FLINT_ANTHROPIC_USD_PER_MTOK_INPUT=
# FLINT_ANTHROPIC_USD_PER_MTOK_OUTPUT=
#
# DeepSeek（OpenAI 兼容；base_url 默认 https://api.deepseek.com，可选覆盖）
# FLINT_DEEPSEEK_API_KEY=
# FLINT_DEEPSEEK_MODEL=
# FLINT_DEEPSEEK_USD_PER_MTOK_INPUT=      # 未命中输入单价
# FLINT_DEEPSEEK_USD_PER_MTOK_OUTPUT=
# FLINT_DEEPSEEK_USD_PER_MTOK_CACHE_HIT=  # 前缀缓存命中单价；出现命中却没配 → 报错，NEVER 按未命中价顶上
# FLINT_DEEPSEEK_BASE_URL=
#
# OpenAI（base_url 默认 https://api.openai.com/v1，可选覆盖）
# FLINT_OPENAI_API_KEY=
# FLINT_OPENAI_MODEL=
# FLINT_OPENAI_USD_PER_MTOK_INPUT=
# FLINT_OPENAI_USD_PER_MTOK_OUTPUT=
# FLINT_OPENAI_BASE_URL=
#
# Z 线（任务一次通过率；不设即用 flint/config.py 的初值 0.95）
# FLINT_Z_LINE=
